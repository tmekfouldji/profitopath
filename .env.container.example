# Local production-shaped Docker Compose environment only. Never use these values in production.
NODE_ENV=production
LOG_LEVEL=info
BUSINESS_TIMEZONE=UTC
DATABASE_URL=postgresql://profitopath:profitopath_dev@postgres:5432/profitopath?schema=public
VALKEY_URL=redis://valkey:6379
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET intentionally comes from the root .env, so local host and Docker web processes
# share the same stable signing key. Do not add production secrets to this file.
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=25
MOCK_PAYMENT_SIGNING_SECRET=local-container-only-mock-payment-secret
# Keep this as `mock`. A real provider source cannot be activated until Phase 9 approval.
MARKET_DATA_SOURCE=mock
MOCK_MARKET_DATA_ENABLED=true
COMPETITION_JOBS_ENABLED=true
COMPETITION_JOB_INTERVAL_MS=15000
AUTO_FINALIZE_FROZEN_COMPETITIONS=false
WEB_PORT=3000
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
WORKER_PORT=3002
DEV_ROOKIE_STARTING_BALANCE_MINOR=1000000
DEV_TRADER_STARTING_BALANCE_MINOR=2000000
DEV_ELITE_STARTING_BALANCE_MINOR=4000000
