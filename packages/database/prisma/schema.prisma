generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRADER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CompetitionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  FROZEN
  FINALIZED
  ARCHIVED
  CANCELLED
}

enum CompetitionEntryStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  BREACHED
  DISQUALIFIED
  CANCELLED
}

enum TradingAccountStatus {
  PENDING
  ACTIVE
  BREACHED
  DISQUALIFIED
  COMPLETED
  CLOSED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LOSS
  TAKE_PROFIT
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum BalanceLedgerType {
  INITIAL_BALANCE
  REALIZED_PNL
  COMMISSION
  SWAP
  ADJUSTMENT
}

enum RuleBreachType {
  MAX_DRAWDOWN
  DAILY_LOSS
  WEEKLY_CUTOFF
  ADMIN_DISQUALIFICATION
  OTHER
}

enum PaymentProvider {
  MOCK
  NOWPAYMENTS
}

enum PaymentStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PrizeStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAYOUT_PENDING
  PAID
  VOID
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum WinnerReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PrizeKycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum FreeEntryCreditStatus {
  AVAILABLE
  REDEEMED
  VOID
}

enum LeaderboardEligibilityStatus {
  ELIGIBLE
  ENTRY_STATUS
  ACCOUNT_STATUS
  RULE_BREACH
  DISQUALIFIED
  MISSING_SNAPSHOT
}

model User {
  id               String              @id @default(uuid()) @db.Uuid
  email            String              @unique @db.VarChar(320)
  emailVerified    DateTime?           @db.Timestamptz(3)
  name             String?             @db.VarChar(100)
  displayName      String?             @db.VarChar(100)
  image            String?             @db.Text
  role             UserRole            @default(TRADER)
  status           UserStatus          @default(ACTIVE)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  profile          UserProfile?
  entries          CompetitionEntry[]
  payments         Payment[]
  auditEvents      AuditEvent[]
  authAccounts     Account[]
  authSessions     Session[]
  credential       PasswordCredential?
  freeEntryCredits FreeEntryCredit[]
}

model WebsiteVisit {
  id          String   @id @default(uuid()) @db.Uuid
  visitorHash String   @db.Char(64)
  visitDay    DateTime @db.Date
  entryPath   String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([visitorHash, visitDay])
  @@index([visitDay])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String  @db.VarChar(32)
  provider          String  @db.VarChar(100)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(64)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.VarChar(320)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([identifier, expires])
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  userId       String    @id @db.Uuid
  countryCode  String?   @db.Char(2)
  timezone     String    @default("UTC") @db.VarChar(64)
  termsVersion String?   @db.VarChar(50)
  acceptedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChallengeTier {
  id                        String                  @id @default(uuid()) @db.Uuid
  code                      String                  @unique @db.VarChar(32)
  name                      String                  @db.VarChar(80)
  entryFeeMinor             Int
  currency                  String                  @default("USD") @db.Char(3)
  maxDrawdownMinor          BigInt
  performanceBenchmarkMinor BigInt
  startingBalanceMinor      BigInt
  rulesVersion              Int                     @default(1)
  active                    Boolean                 @default(true)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(3)
  entries                   CompetitionEntry[]
  prizes                    Prize[]
  leaderboardScoreInputs    LeaderboardScoreInput[]
  leaderboardStandings      LeaderboardStanding[]

  @@index([active])
}

model Competition {
  id                     String                   @id @default(uuid()) @db.Uuid
  code                   String                   @unique @db.VarChar(64)
  name                   String                   @db.VarChar(120)
  status                 CompetitionStatus        @default(DRAFT)
  timezone               String                   @default("UTC") @db.VarChar(64)
  signupClosesAt         DateTime                 @db.Timestamptz(3)
  tradingStartsAt        DateTime                 @db.Timestamptz(3)
  tradingEndsAt          DateTime                 @db.Timestamptz(3)
  rulesVersion           Int
  finalizedAt            DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  entries                CompetitionEntry[]
  prizes                 Prize[]
  finalization           LeaderboardFinalization?
  leaderboardScoreInputs LeaderboardScoreInput[]
  leaderboardStandings   LeaderboardStanding[]

  @@index([status, tradingStartsAt, tradingEndsAt])
}

model CompetitionEntry {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  competitionId          String                  @db.Uuid
  tierId                 String                  @db.Uuid
  status                 CompetitionEntryStatus  @default(PENDING_PAYMENT)
  activatedAt            DateTime?               @db.Timestamptz(3)
  completedAt            DateTime?               @db.Timestamptz(3)
  disqualifiedAt         DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  competition            Competition             @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  tier                   ChallengeTier           @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tradingAccount         TradingAccount?
  payments               Payment[]
  wonPrize               Prize?                  @relation("PrizeWinner")
  leaderboardScoreInputs LeaderboardScoreInput[]
  leaderboardStandings   LeaderboardStanding[]

  @@unique([userId, competitionId, tierId])
  @@index([competitionId, tierId, status])
}

model TradingAccount {
  id                     String                      @id @default(uuid()) @db.Uuid
  competitionEntryId     String                      @unique @db.Uuid
  status                 TradingAccountStatus        @default(PENDING)
  currency               String                      @default("USD") @db.Char(3)
  startingBalanceMinor   BigInt
  balanceMinor           BigInt
  realizedPnlMinor       BigInt                      @default(0)
  configVersion          Int
  breachedAt             DateTime?                   @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  competitionEntry       CompetitionEntry            @relation(fields: [competitionEntryId], references: [id], onDelete: Restrict)
  orders                 Order[]
  executions             Execution[]
  positions              Position[]
  closedTrades           ClosedTrade[]
  balanceLedgerEntries   AccountBalanceLedgerEntry[]
  snapshots              AccountSnapshot[]
  ruleBreaches           RuleBreach[]
  leaderboardScoreInputs LeaderboardScoreInput[]

  @@index([status])
}

model Order {
  id                      String                  @id @default(uuid()) @db.Uuid
  tradingAccountId        String                  @db.Uuid
  clientOrderId           String                  @db.VarChar(100)
  symbol                  String                  @db.VarChar(32)
  instrumentVersion       Int                     @default(1)
  side                    OrderSide
  type                    OrderType
  status                  OrderStatus             @default(PENDING)
  quantity                Decimal                 @db.Decimal(30, 12)
  filledQuantity          Decimal                 @default(0) @db.Decimal(30, 12)
  requestedPrice          Decimal?                @db.Decimal(30, 12)
  limitPrice              Decimal?                @db.Decimal(30, 12)
  stopPrice               Decimal?                @db.Decimal(30, 12)
  stopLossPrice           Decimal?                @db.Decimal(30, 12)
  takeProfitPrice         Decimal?                @db.Decimal(30, 12)
  averageFillPrice        Decimal?                @db.Decimal(30, 12)
  rejectionReason         String?                 @db.VarChar(500)
  terminalReason          String?                 @db.VarChar(500)
  protectedPositionId     String?                 @db.Uuid
  ocoGroupId              String?                 @db.VarChar(128)
  triggerQuoteSequence    BigInt?
  triggeredAt             DateTime?               @db.Timestamptz(3)
  submittedAt             DateTime                @default(now()) @db.Timestamptz(3)
  acceptedAt              DateTime?               @db.Timestamptz(3)
  completedAt             DateTime?               @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  tradingAccount          TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  instrumentConfiguration InstrumentConfiguration @relation(fields: [symbol, instrumentVersion], references: [symbol, version], onDelete: Restrict)
  protectedPosition       Position?               @relation("PositionProtection", fields: [protectedPositionId], references: [id], onDelete: Restrict)
  executions              Execution[]

  @@unique([tradingAccountId, clientOrderId])
  @@index([tradingAccountId, status])
  @@index([symbol, status])
  @@index([symbol, status, type, acceptedAt])
  @@index([protectedPositionId, status])
  @@index([ocoGroupId, status])
}

model Execution {
  id                      String                  @id @default(uuid()) @db.Uuid
  engineEventId           String                  @unique @db.VarChar(128)
  orderId                 String                  @db.Uuid
  tradingAccountId        String                  @db.Uuid
  symbol                  String                  @db.VarChar(32)
  instrumentVersion       Int                     @default(1)
  side                    OrderSide
  quantity                Decimal                 @db.Decimal(30, 12)
  price                   Decimal                 @db.Decimal(30, 12)
  notional                Decimal                 @db.Decimal(38, 12)
  commission              Decimal                 @default(0) @db.Decimal(30, 12)
  executedAt              DateTime                @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  order                   Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tradingAccount          TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  instrumentConfiguration InstrumentConfiguration @relation(fields: [symbol, instrumentVersion], references: [symbol, version], onDelete: Restrict)
  openedTrades            ClosedTrade[]           @relation("OpeningExecution")
  closedTrades            ClosedTrade[]           @relation("ClosingExecution")
  openedPositions         Position[]              @relation("PositionOpeningExecution")

  @@index([tradingAccountId, executedAt])
  @@index([orderId, executedAt])
}

model Position {
  id                      String                  @id @default(uuid()) @db.Uuid
  tradingAccountId        String                  @db.Uuid
  symbol                  String                  @db.VarChar(32)
  instrumentVersion       Int                     @default(1)
  openingExecutionId      String?                 @db.Uuid
  side                    PositionSide
  status                  PositionStatus          @default(OPEN)
  quantity                Decimal                 @db.Decimal(30, 12)
  averageEntryPrice       Decimal                 @db.Decimal(30, 12)
  realizedPnl             Decimal                 @default(0) @db.Decimal(30, 12)
  stopLossPrice           Decimal?                @db.Decimal(30, 12)
  takeProfitPrice         Decimal?                @db.Decimal(30, 12)
  openedAt                DateTime                @db.Timestamptz(3)
  closedAt                DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  tradingAccount          TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  instrumentConfiguration InstrumentConfiguration @relation(fields: [symbol, instrumentVersion], references: [symbol, version], onDelete: Restrict)
  openingExecution        Execution?              @relation("PositionOpeningExecution", fields: [openingExecutionId], references: [id], onDelete: Restrict)
  protectionOrders        Order[]                 @relation("PositionProtection")
  closedTrades            ClosedTrade[]

  @@index([tradingAccountId, symbol, status])
}

model ClosedTrade {
  id                      String                  @id @default(uuid()) @db.Uuid
  tradingAccountId        String                  @db.Uuid
  positionId              String                  @db.Uuid
  openingExecutionId      String                  @db.Uuid
  closingExecutionId      String                  @unique @db.Uuid
  symbol                  String                  @db.VarChar(32)
  instrumentVersion       Int                     @default(1)
  side                    PositionSide
  quantity                Decimal                 @db.Decimal(30, 12)
  entryPrice              Decimal                 @db.Decimal(30, 12)
  exitPrice               Decimal                 @db.Decimal(30, 12)
  realizedPnl             Decimal                 @db.Decimal(30, 12)
  commission              Decimal                 @default(0) @db.Decimal(30, 12)
  openedAt                DateTime                @db.Timestamptz(3)
  closedAt                DateTime                @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  tradingAccount          TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  instrumentConfiguration InstrumentConfiguration @relation(fields: [symbol, instrumentVersion], references: [symbol, version], onDelete: Restrict)
  position                Position                @relation(fields: [positionId], references: [id], onDelete: Restrict)
  openingExecution        Execution               @relation("OpeningExecution", fields: [openingExecutionId], references: [id], onDelete: Restrict)
  closingExecution        Execution               @relation("ClosingExecution", fields: [closingExecutionId], references: [id], onDelete: Restrict)

  @@index([tradingAccountId, closedAt])
}

model InstrumentConfiguration {
  id              String        @id @default(uuid()) @db.Uuid
  symbol          String        @db.VarChar(32)
  version         Int
  active          Boolean       @default(true)
  baseCurrency    String        @db.Char(3)
  quoteCurrency   String        @db.Char(3)
  priceScale      Int
  quantityStep    Decimal       @db.Decimal(30, 12)
  minimumQuantity Decimal       @db.Decimal(30, 12)
  contractSize    Decimal       @db.Decimal(30, 12)
  leverage        Decimal       @db.Decimal(30, 12)
  marketHoursMode String        @default("UTC_24X5") @db.VarChar(32)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  orders          Order[]
  executions      Execution[]
  positions       Position[]
  closedTrades    ClosedTrade[]

  @@unique([symbol, version])
  @@index([active, symbol])
}

model MarketCandle {
  id          String   @id @default(uuid()) @db.Uuid
  symbol      String   @db.VarChar(32)
  timeframe   String   @db.VarChar(8)
  openTime    DateTime @db.Timestamptz(3)
  closeTime   DateTime @db.Timestamptz(3)
  open        Decimal  @db.Decimal(30, 12)
  high        Decimal  @db.Decimal(30, 12)
  low         Decimal  @db.Decimal(30, 12)
  close       Decimal  @db.Decimal(30, 12)
  volume      Decimal? @db.Decimal(38, 12)
  source      String   @db.VarChar(32)
  isFinal     Boolean
  dataVersion Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, isFinal, openTime])
}

model AccountBalanceLedgerEntry {
  id                String            @id @default(uuid()) @db.Uuid
  tradingAccountId  String            @db.Uuid
  type              BalanceLedgerType
  amountMinor       BigInt
  balanceAfterMinor BigInt
  idempotencyKey    String            @unique @db.VarChar(128)
  referenceType     String?           @db.VarChar(64)
  referenceId       String?           @db.VarChar(128)
  occurredAt        DateTime          @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  tradingAccount    TradingAccount    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)

  @@index([tradingAccountId, occurredAt])
}

model AccountSnapshot {
  id                     String                  @id @default(uuid()) @db.Uuid
  tradingAccountId       String                  @db.Uuid
  sequence               BigInt
  balanceMinor           BigInt
  equityMinor            BigInt
  marginUsedMinor        BigInt
  marginFreeMinor        BigInt
  unrealizedPnlMinor     BigInt
  maxDrawdownMinor       BigInt
  dataVersion            Int
  sourceEventId          String?                 @unique @db.VarChar(128)
  asOf                   DateTime                @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  tradingAccount         TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  leaderboardScoreInputs LeaderboardScoreInput[]

  @@unique([tradingAccountId, sequence])
  @@index([tradingAccountId, asOf])
}

model RuleBreach {
  id               String         @id @default(uuid()) @db.Uuid
  tradingAccountId String         @db.Uuid
  type             RuleBreachType
  observedMinor    BigInt?
  thresholdMinor   BigInt?
  rulesVersion     Int
  sourceEventId    String         @unique @db.VarChar(128)
  details          Json?
  occurredAt       DateTime       @db.Timestamptz(3)
  resolvedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)

  @@index([tradingAccountId, occurredAt])
}

model Payment {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  competitionEntryId String?                @db.Uuid
  provider           PaymentProvider        @default(MOCK)
  providerInvoiceId  String?                @unique @db.VarChar(128)
  providerPaymentId  String?                @unique @db.VarChar(128)
  idempotencyKey     String                 @unique @db.VarChar(128)
  status             PaymentStatus          @default(CREATED)
  amountMinor        Int
  currency           String                 @default("USD") @db.Char(3)
  metadata           Json?
  checkoutUrl        String?                @db.Text
  expiresAt          DateTime?              @db.Timestamptz(3)
  confirmedAt        DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  competitionEntry   CompetitionEntry?      @relation(fields: [competitionEntryId], references: [id], onDelete: Restrict)
  providerEvents     PaymentProviderEvent[]

  @@index([userId, status])
}

model PaymentProviderEvent {
  id                String          @id @default(uuid()) @db.Uuid
  paymentId         String          @db.Uuid
  provider          PaymentProvider
  providerEventId   String          @db.VarChar(128)
  providerPaymentId String          @db.VarChar(128)
  status            PaymentStatus
  payloadHash       String          @db.Char(64)
  receivedAt        DateTime        @default(now()) @db.Timestamptz(3)
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
}

model Prize {
  id                     String                   @id @default(uuid()) @db.Uuid
  competitionId          String                   @db.Uuid
  tierId                 String                   @db.Uuid
  rank                   Int
  amountMinor            Int
  currency               String                   @default("USD") @db.Char(3)
  freeEntryCredits       Int                      @default(0)
  status                 PrizeStatus              @default(PENDING_REVIEW)
  winnerEntryId          String?                  @unique @db.Uuid
  sourceFinalizationId   String?                  @db.Uuid
  sourceStandingId       String?                  @unique @db.Uuid
  sourceResultHash       String?                  @db.VarChar(128)
  winnerReviewStatus     WinnerReviewStatus       @default(PENDING)
  winnerReviewedByUserId String?                  @db.Uuid
  winnerReviewedAt       DateTime?                @db.Timestamptz(3)
  kycStatus              PrizeKycStatus           @default(NOT_STARTED)
  kycReviewedByUserId    String?                  @db.Uuid
  kycReviewedAt          DateTime?                @db.Timestamptz(3)
  kycReason              String?                  @db.VarChar(1000)
  reviewReason           String?                  @db.VarChar(1000)
  approvedByUserId       String?                  @db.Uuid
  approvedAt             DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  competition            Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  tier                   ChallengeTier            @relation(fields: [tierId], references: [id], onDelete: Restrict)
  winnerEntry            CompetitionEntry?        @relation("PrizeWinner", fields: [winnerEntryId], references: [id], onDelete: Restrict)
  sourceFinalization     LeaderboardFinalization? @relation(fields: [sourceFinalizationId], references: [id], onDelete: Restrict)
  sourceStanding         LeaderboardStanding?     @relation(fields: [sourceStandingId], references: [id], onDelete: Restrict)
  payout                 Payout?
  issuedFreeEntryCredits FreeEntryCredit[]

  @@unique([competitionId, tierId, rank])
  @@index([competitionId, status])
  @@index([winnerEntryId, winnerReviewStatus, kycStatus])
}

model Payout {
  id                   String       @id @default(uuid()) @db.Uuid
  prizeId              String       @unique @db.Uuid
  status               PayoutStatus @default(PENDING)
  amountMinor          Int
  currency             String       @default("USD") @db.Char(3)
  transactionReference String?      @unique @db.VarChar(255)
  approvedByUserId     String?      @db.Uuid
  approvedAt           DateTime?    @db.Timestamptz(3)
  processingAt         DateTime?    @db.Timestamptz(3)
  paidByUserId         String?      @db.Uuid
  paidAt               DateTime?    @db.Timestamptz(3)
  reconciledByUserId   String?      @db.Uuid
  reconciledAt         DateTime?    @db.Timestamptz(3)
  reconciliationNote   String?      @db.VarChar(1000)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  prize                Prize        @relation(fields: [prizeId], references: [id], onDelete: Restrict)

  @@index([status, reconciledAt])
}

model FreeEntryCredit {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  sourcePrizeId String                @db.Uuid
  ordinal       Int
  status        FreeEntryCreditStatus @default(AVAILABLE)
  redeemedAt    DateTime?             @db.Timestamptz(3)
  voidedAt      DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourcePrize   Prize                 @relation(fields: [sourcePrizeId], references: [id], onDelete: Restrict)

  @@unique([sourcePrizeId, ordinal])
  @@index([userId, status])
}

model LeaderboardFinalization {
  id            String                @id @default(uuid()) @db.Uuid
  competitionId String                @unique @db.Uuid
  rulesVersion  Int
  resultHash    String                @db.VarChar(128)
  result        Json
  finalizedAt   DateTime              @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  standings     LeaderboardStanding[]
  prizes        Prize[]
}

model LeaderboardScoreInput {
  id                       String                       @id @default(uuid()) @db.Uuid
  competitionId            String                       @db.Uuid
  entryId                  String                       @db.Uuid
  tierId                   String                       @db.Uuid
  tradingAccountId         String                       @db.Uuid
  sourceSnapshotId         String?                      @db.Uuid
  policyVersion            Int
  eligibilityStatus        LeaderboardEligibilityStatus
  displayName              String                       @db.VarChar(100)
  startingBalanceMinor     BigInt
  equityMinor              BigInt
  netPerformanceMinor      BigInt
  maxObservedDrawdownMinor BigInt
  finalScoreReachedAt      DateTime                     @db.Timestamptz(3)
  activatedAt              DateTime                     @db.Timestamptz(3)
  cutoffAt                 DateTime                     @db.Timestamptz(3)
  capturedAt               DateTime                     @db.Timestamptz(3)
  dataVersion              Int                          @default(1)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(3)
  competition              Competition                  @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entry                    CompetitionEntry             @relation(fields: [entryId], references: [id], onDelete: Restrict)
  tier                     ChallengeTier                @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tradingAccount           TradingAccount               @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  sourceSnapshot           AccountSnapshot?             @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)

  @@unique([competitionId, entryId, policyVersion])
  @@index([competitionId, tierId, eligibilityStatus])
  @@index([tradingAccountId, cutoffAt])
}

model LeaderboardStanding {
  id                       String                  @id @default(uuid()) @db.Uuid
  finalizationId           String                  @db.Uuid
  competitionId            String                  @db.Uuid
  tierId                   String                  @db.Uuid
  entryId                  String                  @db.Uuid
  policyVersion            Int
  rank                     Int
  displayOrder             Int
  isTied                   Boolean                 @default(false)
  displayName              String                  @db.VarChar(100)
  startingBalanceMinor     BigInt
  equityMinor              BigInt
  netPerformanceMinor      BigInt
  maxObservedDrawdownMinor BigInt
  finalScoreReachedAt      DateTime                @db.Timestamptz(3)
  activatedAt              DateTime                @db.Timestamptz(3)
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  finalization             LeaderboardFinalization @relation(fields: [finalizationId], references: [id], onDelete: Restrict)
  competition              Competition             @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  tier                     ChallengeTier           @relation(fields: [tierId], references: [id], onDelete: Restrict)
  entry                    CompetitionEntry        @relation(fields: [entryId], references: [id], onDelete: Restrict)
  prize                    Prize?

  @@unique([finalizationId, entryId])
  @@unique([finalizationId, tierId, displayOrder])
  @@index([competitionId, tierId, rank, displayOrder])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  entityType     String   @db.VarChar(80)
  entityId       String   @db.VarChar(128)
  action         String   @db.VarChar(100)
  reason         String?  @db.VarChar(1000)
  before         Json?
  after          Json?
  correlationId  String?  @db.VarChar(128)
  idempotencyKey String?  @unique @db.VarChar(128)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
}
