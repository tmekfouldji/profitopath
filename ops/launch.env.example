# Copy this file to the ignored .env.launch on the deployment host. Materialize its real values from
# the production secret manager; do not commit or transfer that resulting file outside the host.
NODE_ENV=production
LOG_LEVEL=info

# External managed services only. Never run the authoritative PostgreSQL ledger on this launch VM.
DATABASE_URL=postgresql://REPLACE_WITH_MANAGED_DATABASE_URL/profitopath?sslmode=require
VALKEY_URL=redis://REPLACE_WITH_MANAGED_VALKEY_HOST:6379

# Public ingress. This DNS record must resolve to the launch VM before Caddy starts.
PROFITOPATH_PUBLIC_HOST=app.example.com
NEXTAUTH_URL=https://app.example.com
NEXT_PUBLIC_REALTIME_URL=wss://app.example.com/realtime
CADDY_EMAIL=operations@example.com

# Inject the real values from the secret manager during deployment.
NEXTAUTH_SECRET=REPLACE_WITH_A_STABLE_HIGH_ENTROPY_SECRET
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_32_BYTE_BASE64_SECRET
MOCK_PAYMENT_SIGNING_SECRET=REPLACE_WITH_A_SEPARATE_HIGH_ENTROPY_SECRET
NOWPAYMENTS_API_KEY=REPLACE_WITH_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=REPLACE_WITH_NOWPAYMENTS_IPN_SECRET
PAYMENT_PROVIDER=nowpayments

# Preorder-only public launch: no mock quote feed and no real-market-data provider until Phase 9.
# The Twelve Data Basic private probe is loopback-development-only and must never be configured here.
MARKET_DATA_SOURCE=mock
MOCK_MARKET_DATA_ENABLED=false
TWELVE_DATA_PRIVATE_TEST_ENABLED=false
BUSINESS_TIMEZONE=UTC
COMPETITION_JOBS_ENABLED=true
COMPETITION_JOB_INTERVAL_MS=15000
AUTO_FINALIZE_FROZEN_COMPETITIONS=false
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=25
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
