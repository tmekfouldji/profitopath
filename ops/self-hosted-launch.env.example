# Temporary single-host launch environment. Copy this to the ignored .env.launch only on the launch
# VM. Generate the secrets there; do not add a populated version to Git or chat.
NODE_ENV=production
LOG_LEVEL=info

# The production PostgreSQL ledger and Valkey state live only on this VM until the managed-service
# migration. PostgreSQL is not published to the internet.
POSTGRES_DB=profitopath
POSTGRES_USER=profitopath
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
DATABASE_URL=postgresql://profitopath:REPLACE_WITH_SAME_POSTGRES_PASSWORD@postgres:5432/profitopath
VALKEY_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
VALKEY_URL=redis://:REPLACE_WITH_SAME_VALKEY_PASSWORD@valkey:6379

# DNS must resolve before Caddy can obtain HTTPS certificates.
PROFITOPATH_PUBLIC_HOST=profitopath.com
NEXTAUTH_URL=https://profitopath.com
NEXT_PUBLIC_REALTIME_URL=wss://profitopath.com/realtime

# Generate these on the launch VM.
NEXTAUTH_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET
MOCK_PAYMENT_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET
PAYMENT_PROVIDER=mock

# Do not add NOWPayments values until the merchant API key and IPN secret are placed directly in the
# launch-host .env.launch. Then change PAYMENT_PROVIDER to nowpayments and perform the controlled smoke test.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# No real market data during preorder setup.
MARKET_DATA_SOURCE=mock
MOCK_MARKET_DATA_ENABLED=false
BUSINESS_TIMEZONE=UTC
COMPETITION_JOBS_ENABLED=true
COMPETITION_JOB_INTERVAL_MS=15000
AUTO_FINALIZE_FROZEN_COMPETITIONS=false
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=25
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
