# Local development only. Never reuse these credentials outside Docker Compose.
NODE_ENV=development
LOG_LEVEL=info
BUSINESS_TIMEZONE=UTC
DATABASE_URL=postgresql://profitopath:profitopath_dev@localhost:5432/profitopath?schema=public
VALKEY_URL=redis://localhost:6379
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-only-change-this-secret-before-deploying
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=25
MOCK_PAYMENT_SIGNING_SECRET=development-only-mock-payment-signing-secret
# Keep `mock` until a server-only NOWPayments API key and IPN secret are provisioned through a
# secret manager. Never commit or paste those real values into this file.
PAYMENT_PROVIDER=mock
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Email confirmation is mandatory for production registration. Keep the local console transport unless
# you intentionally want to send email from a development environment.
EMAIL_PROVIDER=console
# EMAIL_FROM=contact@profitopath.com
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=465
# SMTP_USER=contact@profitopath.com
# SMTP_PASSWORD=
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# `twelve-data-trial` is a time-limited, staff-only internal validation source described in
# 15_TWELVE_DATA_TRIAL_ACTIVATION.md. Keep `mock` for normal local development.
MARKET_DATA_SOURCE=mock
MOCK_MARKET_DATA_ENABLED=false
# The Twelve Data Basic plan may be used only for the localhost server-only non-display probe documented
# in 14_TWELVE_DATA_PRIVATE_TESTING.md. It does not supply client terminal data or simulated execution.
TWELVE_DATA_PRIVATE_TEST_ENABLED=false
# TWELVE_DATA_API_KEY=
# Five minutes for EUR/USD + GBP/USD stays below the plan's 800-credit daily cap.
TWELVE_DATA_POLL_INTERVAL_MS=300000
# Twelve Data commercial trial: never set these in a browser. The trial source pauses public entry
# sales and allows only active ADMIN/SUPERADMIN staff to access its data on the live host.
# TWELVE_DATA_TRIAL_ENDS_AT=
# TWELVE_DATA_TRIAL_SPREAD_EURUSD=0.00012
# TWELVE_DATA_TRIAL_SPREAD_GBPUSD=0.00024
# Worker bootstrap and individual staff chart requests are capped to seven days of canonical 1m bars.
TWELVE_DATA_TRIAL_HISTORY_MAX_MINUTES=10080
# `true` is mandatory: only active ADMIN/SUPERADMIN accounts can use trial data.
TWELVE_DATA_TRIAL_STAFF_ONLY=true
# Server-to-server historical-backfill boundary. The token stays outside browser code and must be 32+ chars.
# MARKET_DATA_INTERNAL_TOKEN=
# MARKET_DATA_WORKER_INTERNAL_URL=http://127.0.0.1:3002
TWELVE_DATA_RECONNECT_INITIAL_MS=1000
TWELVE_DATA_RECONNECT_MAX_MS=30000
COMPETITION_JOBS_ENABLED=true
COMPETITION_JOB_INTERVAL_MS=15000
# Keep false until the frozen administrative review window has an approved duration.
AUTO_FINALIZE_FROZEN_COMPETITIONS=false
WEB_PORT=3000
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
WORKER_PORT=3002

# Development seed values are configurable and are not approved competition rules.
DEV_ROOKIE_STARTING_BALANCE_MINOR=1000000
DEV_TRADER_STARTING_BALANCE_MINOR=2000000
DEV_ELITE_STARTING_BALANCE_MINOR=4000000
